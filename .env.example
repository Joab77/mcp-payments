# sandbox ou production. En production, PAY_STATE_SECRET est obligatoire et fake interdit.
PAY_ENV=sandbox
PAY_COUNTRY=BJ
# Fournisseurs, par ordre de priorité, séparés par des virgules. Disponibles : fake, mtn-momo.
PAY_PROVIDERS=fake

# Plafonds dans la plus petite unité de la devise du pays.
PAY_MAX_AMOUNT=50000
PAY_MAX_DAILY=200000
PAY_MAX_DAILY_PER_PAYER=100000

# Signe les demandes de confirmation : 32 caractères ou plus.
PAY_STATE_SECRET=

# Par défaut : ~/.mcp-payments-africa/payments.db
PAY_DB_PATH=

# MTN MoMo : la clé d'abonnement vient du portail, les deux suivantes de npm run momo:provision.
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# Hors sandbox seulement, donnés par MTN.
MOMO_BASE_URL=
MOMO_TARGET_ENV=
